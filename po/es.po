#: ejecta.c:396
#, c-format
msgid "%s Encrypted Volume"
msgstr "Volumen cifrado de %s"

#: ejecta.c:397
#, c-format
msgid "%s Volume"
msgstr "Volumen de %s"

#: ejecta.c:506
msgid "The device is in use: close the programs and windows using it."
msgstr ""
"El dispositivo está en uso: cierra los programas y ventanas que lo usen."

#: ejecta.c:508
msgid "Authorization cancelled."
msgstr "Autorización cancelada."

#: ejecta.c:511
msgid "You are not allowed to do this."
msgstr "No tienes permiso para esta operación."

#: ejecta.c:513
msgid "Wrong passphrase."
msgstr "Contraseña incorrecta."

#: ejecta.c:689
#, c-format
msgid "open file: %s"
msgstr "archivo abierto: %s"

#: ejecta.c:691
#, c-format
msgid "%d open file (%s…)"
msgid_plural "%d open files (%s…)"
msgstr[0] "%d archivo abierto (%s…)"
msgstr[1] "%d archivos abiertos (%s…)"

#: ejecta.c:692
msgid "working directory is on the drive"
msgstr "carpeta actual dentro de la unidad"

#: ejecta.c:693
msgid "running from the drive"
msgstr "se ejecuta desde la unidad"

#: ejecta.c:694
msgid "has a file from the drive loaded in memory"
msgstr "tiene un archivo de la unidad cargado en memoria"

#. TRANSLATORS: %s is a list like "foo (PID 12), bar (PID 34)"
#: ejecta.c:778
#, c-format
msgid "%s: they belong to another user or to the system."
msgstr "%s: pertenecen a otro usuario o al sistema."

#: ejecta.c:779
msgid "Some processes could not be closed"
msgstr "No se pudieron cerrar algunos procesos"

#: ejecta.c:796
#, c-format
msgid "None of your processes is using “%s”."
msgstr "Ningún proceso tuyo está usando «%s»."

#: ejecta.c:797
msgid "Nothing to close"
msgstr "Nada que cerrar"

#: ejecta.c:808
msgid "It is being used by:"
msgstr "Lo están usando:"

#: ejecta.c:814
#, c-format
msgid ""
"\n"
"… and %u more"
msgid_plural ""
"\n"
"… and %u more"
msgstr[0] ""
"\n"
"… y %u más"
msgstr[1] ""
"\n"
"… y %u más"

#: ejecta.c:816
msgid ""
"None of your processes is using it: it may be a system process or another "
"user's (an indexer, a backup…)."
msgstr ""
"Ningún proceso tuyo lo está usando: puede ser un proceso del sistema o de "
"otro usuario (un indexador, una copia de seguridad…)."

#: ejecta.c:820
#, c-format
msgid "In use by %u process: see the list in the details."
msgid_plural "In use by %u processes: see the list in the details."
msgstr[0] "En uso por %u proceso: mira la lista en los detalles."
msgstr[1] "En uso por %u procesos: mira la lista en los detalles."

#: ejecta.c:822
msgid "In use by a process that isn't yours (system or another user)."
msgstr "En uso por un proceso que no es tuyo (del sistema o de otro usuario)."

#: ejecta.c:824
#, c-format
msgid "Can't eject “%s”"
msgstr "No se puede expulsar «%s»"

#: ejecta.c:824
#, c-format
msgid "Can't unmount “%s”"
msgstr "No se puede desmontar «%s»"

#: ejecta.c:825
msgid "Close processes and retry"
msgstr "Cerrar procesos y reintentar"

#: ejecta.c:825 ejecta.c:826
msgid "Show details"
msgstr "Ver detalles"

#: ejecta.c:826
msgid "Retry"
msgstr "Reintentar"

#: ejecta.c:848
#, c-format
msgid "“%s” can now be safely removed."
msgstr "Ya puedes retirar «%s» con seguridad."

#: ejecta.c:849
msgid "Device ejected"
msgstr "Dispositivo expulsado"

#: ejecta.c:944
#, c-format
msgid "“%s” is not in use: you can remove it."
msgstr "«%s» no está en uso: puedes retirarlo."

#: ejecta.c:945
msgid "Ready to remove"
msgstr "Listo para retirar"

#: ejecta.c:1049
msgid "SD card reader"
msgstr "Lector de tarjetas (SD)"

#: ejecta.c:1072
msgid "Processes using this device"
msgstr "Procesos que usan el dispositivo"

#: ejecta.c:1076
msgid "Look again"
msgstr "Volver a buscar"

#: ejecta.c:1084
msgid "None of your processes is using it."
msgstr "Ningún proceso tuyo la está usando."

#: ejecta.c:1097
msgid "Close"
msgstr "Cerrar"

#: ejecta.c:1100
msgid "Asks the process to quit; if it doesn't within 3 s, it is forced"
msgstr "Pide al proceso que se cierre; si no responde en 3 s, lo fuerza"

#: ejecta.c:1108
msgid "Close all"
msgstr "Cerrar todos"

#: ejecta.c:1109
msgid "Asks them all to quit; the ones still running after 3 s are forced"
msgstr "Pide a todos que se cierren; los que no respondan en 3 s se fuerzan"

#: ejecta.c:1136 ejecta.c:1549
msgid "working…"
msgstr "trabajando…"

#: ejecta.c:1136
msgid "encrypted, locked"
msgstr "cifrado, bloqueado"

#: ejecta.c:1137 ejecta.c:1549
msgid "mounted"
msgstr "montado"

#: ejecta.c:1137 ejecta.c:1773
msgid "not mounted"
msgstr "sin montar"

#: ejecta.c:1147
msgid "Details"
msgstr "Detalles"

#: ejecta.c:1160
msgid "Unlock"
msgstr "Desbloquear"

#: ejecta.c:1161
msgid "Ask for the passphrase, unlock and mount"
msgstr "Pedir la contraseña, descifrar y montar"

#: ejecta.c:1163 ejecta.c:1887
msgid "Open"
msgstr "Abrir"

#: ejecta.c:1164 ejecta.c:1559
msgid "Open in the file manager"
msgstr "Abrir en el gestor de archivos"

#: ejecta.c:1165
msgid "Unmount"
msgstr "Desmontar"

#: ejecta.c:1166
msgid ""
"Closes the volume (its files stop being accessible) but the device stays "
"connected and powered"
msgstr ""
"Cierra el volumen (deja de estar accesible) pero el dispositivo sigue "
"conectado y encendido"

#: ejecta.c:1169 ejecta.c:1564 ejecta.c:1876
msgid "Mount"
msgstr "Montar"

#: ejecta.c:1169
msgid "Make the files accessible"
msgstr "Hacer accesibles los archivos"

#: ejecta.c:1170 ejecta.c:1876
msgid "Mount & open"
msgstr "Montar y abrir"

#: ejecta.c:1171
msgid "Mount and open in the file manager"
msgstr "Montar y abrir en el gestor de archivos"

#: ejecta.c:1174
msgid "Eject"
msgstr "Expulsar"

#: ejecta.c:1175
msgid ""
"Unmounts everything on the device and powers it off so you can remove it "
"safely"
msgstr ""
"Desmonta todo lo del dispositivo y lo apaga para que puedas retirarlo con "
"seguridad"

#. TRANSLATORS: "<free> free of <total>  ·  <mount point>"
#: ejecta.c:1195
#, c-format
msgid "%s free of %s  ·  %s"
msgstr "%s libres de %s  ·  %s"

#: ejecta.c:1206
msgid "Passphrase, then Enter"
msgstr "Contraseña y Intro"

#: ejecta.c:1231
msgid "Device"
msgstr "Dispositivo"

#: ejecta.c:1232
msgid "Connection"
msgstr "Conexión"

#: ejecta.c:1232
msgid "Disk image (loop)"
msgstr "Imagen de disco (loop)"

#: ejecta.c:1233
msgid "Path"
msgstr "Ruta"

#: ejecta.c:1234
msgid "Mounted at"
msgstr "Montado en"

#: ejecta.c:1235
msgid "Filesystem"
msgstr "Sistema de archivos"

#: ejecta.c:1237
msgid "Serial number"
msgstr "Nº de serie"

#: ejecta.c:1238
msgid "Size"
msgstr "Tamaño"

#: ejecta.c:1239
msgid "Encryption"
msgstr "Cifrado"

#: ejecta.c:1240
msgid "LUKS, locked"
msgstr "LUKS, bloqueado"

#: ejecta.c:1240
msgid "LUKS, unlocked"
msgstr "LUKS, desbloqueado"

#: ejecta.c:1241
msgid "Access"
msgstr "Acceso"

#: ejecta.c:1241
msgid "Read-only"
msgstr "Solo lectura"

#: ejecta.c:1245
msgid "Copy path"
msgstr "Copiar ruta"

#: ejecta.c:1273
msgid "No removable drives connected"
msgstr "No hay unidades extraíbles conectadas"

#: ejecta.c:1339
msgid "Drives"
msgstr "Unidades"

#: ejecta.c:1343
msgid "Eject all removable drives"
msgstr "Expulsar todas las unidades extraíbles"

#: ejecta.c:1357
msgid ""
"Unmount closes the volume; the device stays connected. Eject (⏏) unmounts "
"everything and powers it off: then you can pull it out."
msgstr ""
"Desmontar cierra el volumen; el dispositivo sigue conectado. Expulsar (⏏) lo "
"desmonta todo y lo apaga: después ya puedes quitarlo."

#: ejecta.c:1549 ejecta.c:1773
msgid "locked"
msgstr "bloqueado"

#: ejecta.c:1557
msgid "Operation in progress…"
msgstr "Operación en curso…"

#: ejecta.c:1558
msgid "Unlock and mount…"
msgstr "Desbloquear y montar…"

#: ejecta.c:1561
msgid "Unmount (stays connected)"
msgstr "Desmontar (sigue conectado)"

#: ejecta.c:1562
msgid "Copy mount path"
msgstr "Copiar ruta de montaje"

#: ejecta.c:1566
msgid "Lock"
msgstr "Bloquear"

#: ejecta.c:1567
msgid "Eject to remove it"
msgstr "Expulsar para retirarlo"

#: ejecta.c:1569
msgid "Show details in the panel"
msgstr "Ver detalles en el panel"

#: ejecta.c:1570
msgid "Close the processes using it"
msgstr "Cerrar los procesos que la usan"

#: ejecta.c:1575 ejecta.c:1768
msgid "No removable drives"
msgstr "No hay unidades extraíbles"

#: ejecta.c:1577
msgid "Mount all"
msgstr "Montar todas"

#: ejecta.c:1578
msgid "Unmount all"
msgstr "Desmontar todas"

#: ejecta.c:1579
msgid "Eject all"
msgstr "Expulsar todas"

#: ejecta.c:1581
msgid "Settings"
msgstr "Preferencias"

#: ejecta.c:1583
msgid "Ask to mount when a device is plugged in"
msgstr "Preguntar si montar al conectar un dispositivo"

#: ejecta.c:1584
msgid "Ask to open the file manager after mounting"
msgstr "Preguntar si abrir el gestor de archivos al montar"

#: ejecta.c:1585
msgid "Also show internal disks"
msgstr "Mostrar también discos internos"

#: ejecta.c:1586
msgid "Show the icon even with no drives"
msgstr "Mostrar el icono aunque no haya unidades"

#: ejecta.c:1587
msgid "Open panel"
msgstr "Abrir panel"

#: ejecta.c:1588
msgid "Quit Ejecta"
msgstr "Salir de Ejecta"

#: ejecta.c:1872
msgid "encrypted"
msgstr "cifrado"

#: ejecta.c:1874
msgid "Mount it?"
msgstr "¿Quieres montarlo?"

#: ejecta.c:1875
#, c-format
msgid "Connected: %s"
msgstr "Conectado: %s"

#: ejecta.c:1877
msgid "Unlock…"
msgstr "Desbloquear…"

#: ejecta.c:1885
#, c-format
msgid "Mounted: %s"
msgstr "Montado: %s"

#: ejecta.c:1886
msgid "Open it in the file manager?"
msgstr "¿Abrir en el gestor de archivos?"

#: ejecta.c:2090
msgid "Print the version and exit"
msgstr "Muestra la versión y sale"

#: ejecta.c:2092
msgid "Removable drives in the system tray. Run it again to toggle the panel."
msgstr ""
"Unidades extraíbles en la bandeja del sistema. Ejecútalo otra vez para abrir "
"o cerrar el panel."
